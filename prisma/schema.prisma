generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id     String @id @default(cuid())
  name   String
  email  String @unique
  grades Grade[]
}

model Course {
  id     String @id @default(cuid())
  name   String
  code   String @unique
  grades Grade[]
}

model Grade {
  id        String   @id @default(cuid())
  value     Int
  letter    String?
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
}